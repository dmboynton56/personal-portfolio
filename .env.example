# Server-side Supabase keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Client-side Supabase keys (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key

# LLM Advisor telemetry ingest secret
LLM_ADVISOR_CRON_SECRET=choose-a-long-random-string
# Local development only: production reads LLM Advisor telemetry from Supabase.
LLM_ADVISOR_DAILY_NEWS_DIR=../llm-advisor/data/daily_news

# Optional LLM provider for /api/chat (falls back to rule-based mode if missing)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Hybrid chat backend (BigQuery + Gemini; local docs under /docs; Vertex Search removed)
GCP_PROJECT_ID=your_gcp_project
GCP_LOCATION=us-central1

# Optional offline embedding build for local doc retrieval
VERTEX_AI_PROJECT=your_gcp_project
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_EMBEDDING_MODEL=text-embedding-004
RAG_EMBEDDING_BATCH_SIZE=16

# Local auth options for Google APIs (choose one) — do not commit real key files
GOOGLE_APPLICATION_CREDENTIALS=
GCP_SERVICE_ACCOUNT_JSON=
GCP_SERVICE_ACCOUNT_JSON_BASE64=

# BigQuery chat facts source
BIGQUERY_PROJECT_ID=your_gcp_project
BIGQUERY_DATASET=sports_edge
BIGQUERY_CHAT_VIEW=chat_facts_view

# Optional BigQuery chat view column mapping
BIGQUERY_HOME_TEAM_COLUMN=home_team
BIGQUERY_LEAGUE_COLUMN=league
BIGQUERY_SEASON_COLUMN=season
BIGQUERY_ATS_RESULT_COLUMN=ats_result
BIGQUERY_HOME_COVER_VALUE=HOME_COVER
BIGQUERY_PUSH_VALUE=PUSH

# Season override for "this season" parsing
SPORTS_EDGE_CURRENT_SEASON=2025

# CI only (GitHub secret PORTFOLIO_METRICS_URL): deployed portfolio metrics URL for EOD verification
# Example: https://your-app.vercel.app/api/llm-advisor/metrics
PORTFOLIO_METRICS_URL=
