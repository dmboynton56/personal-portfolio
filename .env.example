# Server-side Supabase keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Client-side Supabase keys (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key

# Sports Edge cron secret shared with GitHub Actions
SPORTS_EDGE_CRON_SECRET=choose-a-long-random-string

# The Odds API configuration
THE_ODDS_API_KEY=replace-with-the-odds-api-key
THE_ODDS_API_REGIONS=us
THE_ODDS_API_MARKETS=spreads
THE_ODDS_API_BOOKMAKERS=draftkings,betmgm

# Optional LLM provider for /api/chat (falls back to rule-based mode if missing)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Hybrid chat backend (BigQuery + Vertex AI Search/Answer)
GCP_PROJECT_ID=learned-pier-478122-p7
GCP_LOCATION=us-central1
VERTEX_APP_ID=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3-flash
VERTEX_TIMEOUT_MS=45000

# Local auth options for Google APIs (choose one)
GOOGLE_APPLICATION_CREDENTIALS=../sports-edge/learned-pier-478122-p7-9cdc2e51a95c.json
GCP_SERVICE_ACCOUNT_JSON=
GCP_SERVICE_ACCOUNT_JSON_BASE64=

# BigQuery chat facts source
BIGQUERY_PROJECT_ID=learned-pier-478122-p7
BIGQUERY_DATASET=sports_edge
BIGQUERY_CHAT_VIEW=chat_facts_view

# Optional BigQuery chat view column mapping
BIGQUERY_HOME_TEAM_COLUMN=home_team
BIGQUERY_LEAGUE_COLUMN=league
BIGQUERY_SEASON_COLUMN=season
BIGQUERY_ATS_RESULT_COLUMN=ats_result
BIGQUERY_HOME_COVER_VALUE=HOME_COVER
BIGQUERY_PUSH_VALUE=PUSH

# Season override for "this season" parsing
SPORTS_EDGE_CURRENT_SEASON=2025
